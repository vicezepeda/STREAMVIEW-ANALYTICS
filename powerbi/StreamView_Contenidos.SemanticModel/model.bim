{
  "name": "StreamView Contenidos",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "es-CL",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "tables": [
      {
        "name": "Catalogo",
        "columns": [
          {
            "name": "Clave",
            "dataType": "string",
            "sourceColumn": "Clave",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Titulo",
            "dataType": "string",
            "sourceColumn": "Titulo",
            "summarizeBy": "none"
          },
          {
            "name": "Tipo",
            "dataType": "string",
            "sourceColumn": "Tipo",
            "summarizeBy": "none"
          },
          {
            "name": "Anio",
            "dataType": "int64",
            "sourceColumn": "Anio",
            "summarizeBy": "none"
          },
          {
            "name": "Incorporacion",
            "dataType": "int64",
            "sourceColumn": "Incorporacion",
            "summarizeBy": "none"
          },
          {
            "name": "Idioma",
            "dataType": "string",
            "sourceColumn": "Idioma",
            "summarizeBy": "none"
          },
          {
            "name": "Calificacion",
            "dataType": "double",
            "sourceColumn": "Calificacion",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "Votos",
            "dataType": "int64",
            "sourceColumn": "Votos",
            "summarizeBy": "none"
          },
          {
            "name": "Popularidad",
            "dataType": "double",
            "sourceColumn": "Popularidad",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "Presupuesto",
            "dataType": "double",
            "sourceColumn": "Presupuesto",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "Ingresos",
            "dataType": "double",
            "sourceColumn": "Ingresos",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "Finanzas",
            "dataType": "string",
            "sourceColumn": "Finanzas",
            "summarizeBy": "none"
          },
          {
            "name": "MuestraRating",
            "dataType": "string",
            "sourceColumn": "MuestraRating",
            "summarizeBy": "none"
          },
          {
            "name": "ROI",
            "dataType": "double",
            "sourceColumn": "ROI",
            "summarizeBy": "none",
            "formatString": "0.00"
          }
        ],
        "partitions": [
          {
            "name": "Catalogo",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "  Filas = Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)),",
                "  Datos = Table.FromRows(Filas, {\"Clave\", \"Titulo\", \"Tipo\", \"Anio\", \"Incorporacion\", \"Idioma\", \"Calificacion\", \"Votos\", \"Popularidad\", \"Presupuesto\", \"Ingresos\", \"Finanzas\", \"MuestraRating\", \"ROI\"}),",
                "  Tipos = Table.TransformColumnTypes(Datos, {{\"Clave\", type text}, {\"Titulo\", type text}, {\"Tipo\", type text}, {\"Anio\", Int64.Type}, {\"Incorporacion\", Int64.Type}, {\"Idioma\", type text}, {\"Calificacion\", type number}, {\"Votos\", Int64.Type}, {\"Popularidad\", type number}, {\"Presupuesto\", type number}, {\"Ingresos\", type number}, {\"Finanzas\", type text}, {\"MuestraRating\", type text}, {\"ROI\", type number}}, \"en-US\")",
                "in Tipos"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Titulos",
            "expression": "DISTINCTCOUNT(Catalogo[Clave])",
            "formatString": "#,0",
            "displayFolder": "Catalogo"
          },
          {
            "name": "Peliculas",
            "expression": "CALCULATE([Titulos], KEEPFILTERS(Catalogo[Tipo] = \"Película\"))",
            "formatString": "#,0",
            "displayFolder": "Catalogo"
          },
          {
            "name": "Series",
            "expression": "CALCULATE([Titulos], KEEPFILTERS(Catalogo[Tipo] = \"Serie\"))",
            "formatString": "#,0",
            "displayFolder": "Catalogo"
          },
          {
            "name": "Paises representados",
            "expression": "DISTINCTCOUNT(Paises[Pais])",
            "formatString": "0",
            "displayFolder": "Catalogo"
          },
          {
            "name": "Idiomas disponibles",
            "expression": "DISTINCTCOUNT(Catalogo[Idioma])",
            "formatString": "0",
            "displayFolder": "Catalogo"
          },
          {
            "name": "Generos disponibles",
            "expression": "DISTINCTCOUNT(Generos[Genero])",
            "formatString": "0",
            "displayFolder": "Catalogo"
          },
          {
            "name": "Popularidad media",
            "expression": "AVERAGE(Catalogo[Popularidad])",
            "formatString": "0.00",
            "displayFolder": "Catalogo"
          },
          {
            "name": "Popularidad mediana",
            "expression": "MEDIAN(Catalogo[Popularidad])",
            "formatString": "0.00",
            "displayFolder": "Catalogo"
          },
          {
            "name": "Calificacion media",
            "expression": "AVERAGE(Catalogo[Calificacion])",
            "formatString": "0.00",
            "displayFolder": "Catalogo"
          },
          {
            "name": "Votaciones promedio",
            "expression": "AVERAGE(Catalogo[Votos])",
            "formatString": "#,0.0",
            "displayFolder": "Catalogo"
          },
          {
            "name": "Calificacion ponderada",
            "expression": "VAR D = FILTER(Catalogo, Catalogo[MuestraRating]=\"Sí\") RETURN DIVIDE(SUMX(D,Catalogo[Calificacion]*Catalogo[Votos]),SUMX(D,Catalogo[Votos]))",
            "formatString": "0.00",
            "displayFolder": "Catalogo"
          },
          {
            "name": "Titulos ranking",
            "expression": "CALCULATE([Titulos], KEEPFILTERS(Catalogo[Votos]>=1000))",
            "formatString": "#,0",
            "displayFolder": "Catalogo"
          },
          {
            "name": "Rating ranking",
            "expression": "CALCULATE([Calificacion media], KEEPFILTERS(Catalogo[Votos]>=1000))",
            "formatString": "0.00",
            "displayFolder": "Catalogo"
          },
          {
            "name": "Votos ranking",
            "expression": "CALCULATE(SUM(Catalogo[Votos]), KEEPFILTERS(Catalogo[Votos]>=1000))",
            "formatString": "#,0",
            "displayFolder": "Catalogo"
          },
          {
            "name": "Calificacion mapa",
            "expression": "VAR N=CALCULATE([Titulos],Catalogo[MuestraRating]=\"Sí\") RETURN IF(N>=30,CALCULATE([Calificacion media],Catalogo[MuestraRating]=\"Sí\"))",
            "formatString": "0.00",
            "displayFolder": "Catalogo"
          },
          {
            "name": "Presupuesto total",
            "expression": "CALCULATE(SUM(Catalogo[Presupuesto]), KEEPFILTERS(Catalogo[Finanzas]=\"Sí\"))",
            "formatString": "\"USD \"#,0,,.0\" M\"",
            "displayFolder": "Finanzas"
          },
          {
            "name": "Ingresos totales",
            "expression": "CALCULATE(SUM(Catalogo[Ingresos]), KEEPFILTERS(Catalogo[Finanzas]=\"Sí\"))",
            "formatString": "\"USD \"#,0,,.0\" M\"",
            "displayFolder": "Finanzas"
          },
          {
            "name": "Presupuesto promedio",
            "expression": "CALCULATE(AVERAGE(Catalogo[Presupuesto]), KEEPFILTERS(Catalogo[Finanzas]=\"Sí\"))",
            "formatString": "\"USD \"#,0,,.0\" M\"",
            "displayFolder": "Finanzas"
          },
          {
            "name": "Ingresos promedio",
            "expression": "CALCULATE(AVERAGE(Catalogo[Ingresos]), KEEPFILTERS(Catalogo[Finanzas]=\"Sí\"))",
            "formatString": "\"USD \"#,0,,.0\" M\"",
            "displayFolder": "Finanzas"
          },
          {
            "name": "Muestra financiera",
            "expression": "CALCULATE([Titulos], KEEPFILTERS(Catalogo[Finanzas]=\"Sí\"))",
            "formatString": "#,0",
            "displayFolder": "Finanzas"
          },
          {
            "name": "Cobertura financiera",
            "expression": "DIVIDE([Muestra financiera],[Peliculas])",
            "formatString": "0.0%",
            "displayFolder": "Finanzas"
          },
          {
            "name": "ROI agregado",
            "expression": "DIVIDE([Ingresos totales]-[Presupuesto total],[Presupuesto total])",
            "formatString": "0.0%",
            "displayFolder": "Finanzas"
          },
          {
            "name": "Ratio ingresos presupuesto",
            "expression": "DIVIDE([Ingresos totales],[Presupuesto total])",
            "formatString": "0.00\"x\"",
            "displayFolder": "Finanzas"
          },
          {
            "name": "ROI mediano",
            "expression": "CALCULATE(MEDIAN(Catalogo[ROI]),KEEPFILTERS(Catalogo[Finanzas]=\"Sí\"))",
            "formatString": "0.0%",
            "displayFolder": "Finanzas"
          },
          {
            "name": "Peliculas bajo presupuesto",
            "expression": "CALCULATE([Muestra financiera], KEEPFILTERS(Catalogo[Presupuesto]<=10000000), KEEPFILTERS(Catalogo[ROI]>0))",
            "formatString": "#,0",
            "displayFolder": "Finanzas"
          },
          {
            "name": "ROI bajo presupuesto",
            "expression": "CALCULATE([ROI agregado],KEEPFILTERS(Catalogo[Presupuesto]<=10000000), KEEPFILTERS(Catalogo[ROI]>0))",
            "formatString": "0.0%",
            "displayFolder": "Finanzas"
          },
          {
            "name": "Top paises",
            "expression": "VAR V = [Titulos] VAR R = RANKX(ALLSELECTED(Paises[Pais]), [Titulos], , DESC, Skip) RETURN IF(NOT ISBLANK(V) && R<=10,V)",
            "formatString": "#,0",
            "displayFolder": "Visualizaciones"
          },
          {
            "name": "Top generos",
            "expression": "VAR V = [Titulos] VAR R = RANKX(ALLSELECTED(Generos[Genero]), [Titulos], , DESC, Skip) RETURN IF(NOT ISBLANK(V) && R<=10,V)",
            "formatString": "#,0",
            "displayFolder": "Visualizaciones"
          },
          {
            "name": "Top actores",
            "expression": "VAR V = [Titulos] VAR R = RANKX(ALLSELECTED(Actores[Actor]), [Titulos], , DESC, Skip) RETURN IF(NOT ISBLANK(V) && R<=10,V)",
            "formatString": "#,0",
            "displayFolder": "Visualizaciones"
          },
          {
            "name": "Top directores",
            "expression": "VAR V = [Titulos] VAR R = RANKX(ALLSELECTED(Directores[Director]), [Titulos], , DESC, Skip) RETURN IF(NOT ISBLANK(V) && R<=10,V)",
            "formatString": "#,0",
            "displayFolder": "Visualizaciones"
          },
          {
            "name": "Top ingresos",
            "expression": "VAR V = [Ingresos totales] VAR R = RANKX(ALLSELECTED(Catalogo[Titulo]), [Ingresos totales], , DESC, Skip) RETURN IF(NOT ISBLANK(V) && R<=10,V)",
            "formatString": "\"USD \"#,0,,.0\" M\"",
            "displayFolder": "Visualizaciones"
          },
          {
            "name": "Top rating",
            "expression": "VAR V = [Rating ranking] VAR R = RANKX(ALLSELECTED(Catalogo[Titulo]), [Rating ranking], , DESC, Skip) RETURN IF(NOT ISBLANK(V) && R<=10,V)",
            "formatString": "0.00",
            "displayFolder": "Visualizaciones"
          },
          {
            "name": "Top bajo presupuesto",
            "expression": "VAR V = [ROI bajo presupuesto] VAR R = RANKX(ALLSELECTED(Catalogo[Titulo]), [ROI bajo presupuesto], , DESC, Skip) RETURN IF(NOT ISBLANK(V) && R<=10,V)",
            "formatString": "0.0%",
            "displayFolder": "Visualizaciones"
          }
        ]
      },
      {
        "name": "Generos",
        "columns": [
          {
            "name": "Clave",
            "dataType": "string",
            "sourceColumn": "Clave",
            "summarizeBy": "none",
