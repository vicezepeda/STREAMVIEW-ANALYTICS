                "  Datos = Table.FromRows(Filas, {\"Clave\", \"Actor\"}),",
                "  Tipos = Table.TransformColumnTypes(Datos, {{\"Clave\", type text}, {\"Actor\", type text}}, \"en-US\")",
                "in Tipos"
