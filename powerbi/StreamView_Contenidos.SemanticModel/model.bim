        ],
        "partitions": [
          {
            "name": "Generos",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "  Filas = Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)),",
                "  Datos = Table.FromRows(Filas, {\"Clave\", \"Genero\"}),",
                "  Tipos = Table.TransformColumnTypes(Datos, {{\"Clave\", type text}, {\"Genero\", type text}}, \"en-US\")",
                "in Tipos"
